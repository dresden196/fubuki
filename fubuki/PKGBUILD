# Maintainer: Dresden Wildey <dresden196@gmail.com>
#
# The engine. Everything that touches a disk is here; the window (fubuki-ui)
# only draws what this reports and hands it a job.
#
# The design and the boot payloads come from Rufus (GPLv3, Pete Batard):
# uefi-ntfs.img, FreeDOS, the Windows 11 24H2 setup wrapper, and the boot
# sector code ported from ms-sys. See fubuki/bootcode.py and payload/.
pkgname=fubuki
pkgver=0.1.0
pkgrel=1
pkgdesc="Fubuki bootable USB writer: the engine and command line"
arch=('any')
url="https://github.com/dresden196/fubuki"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyudev' 'util-linux' 'dosfstools' 'ntfs-3g' 'exfatprogs' 'e2fsprogs'
         # Boot loaders for BIOS boot of Linux images. Rufus carries its own
         # ldlinux.sys and core.img; here the real installers do the work.
         'syslinux' 'grub'
         # Windows: split install.wim for FAT32, patch boot.wim, apply Windows To Go.
         'wimlib'
         # Editing the offline registry (the TPM/Secure Boot bypass keys, BCD stores).
         'hivex'
         # Bad block scan, partition re-read.
         'parted'
         'polkit')
optdepends=('zstd: writing .zst compressed images')
source=('io.github.dresden196.fubuki.policy')
sha256sums=('SKIP')

package() {
    install -Dm755 "$startdir/bin/fubuki" "$pkgdir/usr/bin/fubuki"
    install -d "$pkgdir/usr/lib/fubuki/fubuki"
    install -Dm644 "$startdir"/fubuki/*.py -t "$pkgdir/usr/lib/fubuki/fubuki/"
    install -d "$pkgdir/usr/share/fubuki"
    cp -r "$startdir/payload/." "$pkgdir/usr/share/fubuki/"
    find "$pkgdir/usr/share/fubuki" -type f -exec chmod 644 {} +
    install -Dm644 "$srcdir/io.github.dresden196.fubuki.policy" \
        "$pkgdir/usr/share/polkit-1/actions/io.github.dresden196.fubuki.policy"
    install -Dm644 "$startdir/PROTOCOL.md" "$pkgdir/usr/share/doc/fubuki/PROTOCOL.md"
}
