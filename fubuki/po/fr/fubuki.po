#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "type de MBR inconnu : %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "espace insuffisant avant la première partition pour le chargeur de démarrage (décochez « Ajouter des corrections pour les anciens BIOS »)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "le nouveau volume n'a pas de secteur de démarrage NTFS"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "le nouveau volume n'a pas de secteur de démarrage FAT32"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "le nouveau volume n'a pas de secteur de démarrage FAT16"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "pas de prise en charge des secteurs de démarrage pour %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "L'écriture d'un lecteur nécessite les droits root : exécutez via pkexec ou sudo"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s n'est pas un disque"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "« %s » fait %s : FAT32 ne peut pas contenir de fichiers de plus de 4 Go. Utilisez NTFS ou exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "impossible d'écrire %s : %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "la division de %s nécessite %s d'espace temporaire dans %s, seulement %s disponible. Utilisez NTFS à la place de FAT32, ou définissez TMPDIR sur un emplacement disposant de plus d'espace."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Division de install.wim pour FAT32…"

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "système de fichiers non pris en charge : %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s n'est pas un fichier"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "type de démarrage inconnu : %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "le schéma doit être mbr ou gpt"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "la cible doit être bios, uefi ou dual"

#: fubuki/job.py:126
msgid "no image given"
msgstr "aucune image indiquée"

#: fubuki/job.py:128
msgid "no device given"
msgstr "aucun périphérique indiqué"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT nécessite une cible UEFI"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS nécessite une partition principale NTFS ou exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s contient le système en cours d'exécution ; écriture refusée"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s est un lecteur interne ; écriture refusée"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s est un périphérique loop ; écriture refusée"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Analyse de l'image…"

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "cette ISO n'est pas une image hybride et ne peut pas être écrite en mode DD"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go nécessite une image contenant sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go nécessite NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "cette image contient des fichiers de plus de 4 Go qui ne peuvent pas être divisés ; utilisez NTFS ou exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "cette image ne prend pas en charge de partition persistante"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "cette image contient des fichiers de plus de 4 Go ; FAT32 ne peut pas les contenir, utilisez NTFS ou exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "l'image nécessite %s mais le lecteur ne dispose que de %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Écriture de l'image…"

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Finalisation…"

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Mise à zéro du lecteur…"

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Création de la table de partitions…"

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Formatage…"

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Écriture des secteurs de démarrage…"

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Copie des fichiers…"

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Préparation du volume…"

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "impossible de relire les GUID de partition depuis la nouvelle table"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Application de la personnalisation…"

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Finalisation des fichiers…"

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Vérification des blocs défectueux…"

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "la vérification des blocs défectueux a trouvé %d bloc(s) défectueux ; ce lecteur ne doit pas être considéré comme fiable"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go nécessite %s d'espace temporaire dans %s ; seulement %s disponible (définissez TMPDIR sur un emplacement disposant de plus d'espace)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Extraction de l'image d'installation…"

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "l'image ne contient pas de modèle BCD à partir duquel générer le magasin de démarrage"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "schéma de partition inconnu : %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "une partition MSR nécessite GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "persistance demandée sans taille indiquée"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "trop de partitions"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s ne tient pas sur ce lecteur"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "le lecteur est trop petit pour cette disposition"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s n'est pas apparu après le partitionnement"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "échec d'extlinux : %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s est un espace swap actif ; désactivez-le d'abord"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s est en cours d'utilisation (%s) ; fermez tout ce qui l'utilise et réessayez"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "impossible de monter %s (%s) : %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "aucun assistant de montage"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "« %s » n'est pas disponible sur ce système%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "échec de %s : %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "écriture incomplète sur %s à %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "fichier de charge utile manquant : %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s n'est pas un fichier WIM"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s n'a pas d'index XML"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "échec de wimupdate : %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "échec de wimapply : %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "la ruche SYSTEM n'a pas de clé Setup"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Application de la personnalisation Windows…"

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim introuvable ; impossible d'ajouter le fichier de réponses"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "Mise à jour de boot.wim…"

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s introuvable sur le support"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "le support contient \\minint mais aucune option /minint ni \\i386 : impossible de déterminer comment le démarrer"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s introuvable dans %s"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "aucune entrée de chargeur de système d'exploitation dans le modèle BCD"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Application de l'image Windows (cela peut prendre du temps)…"

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "l'image appliquée n'a pas de répertoire Windows"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "l'image appliquée n'a pas de Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "impossible de monter %s (NTFS) : ni ntfs3 ni ntfs-3g n'ont fonctionné"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "seules les images VHD de taille fixe peuvent être écrites ; convertissez d'abord les VHD/VHDX dynamiques avec qemu-img"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "l'image fait %s mais le lecteur ne contient que %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "l'image est plus grande que le lecteur"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "échec de la vérification au décalage %s : le lecteur ne contient pas ce qui a été écrit"
