#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "неизвестный тип MBR %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "недостаточно места перед первым разделом для загрузчика (снимите флажок «Добавить исправления для старых BIOS»)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "новый том не имеет загрузочного сектора NTFS"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "новый том не имеет загрузочного сектора FAT32"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "новый том не имеет загрузочного сектора FAT16"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "нет поддержки загрузочной записи для %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Запись на диск требует прав root: запустите через pkexec или sudo"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s не является диском"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "«%s» имеет размер %s: FAT32 не поддерживает файлы размером более 4 ГБ. Используйте NTFS или exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "не удалось записать %s: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "для разделения %s требуется %s временного места в %s, доступно только %s. Используйте NTFS вместо FAT32 или укажите в TMPDIR каталог с большим объёмом свободного места."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Разделение install.wim для FAT32…"

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "неподдерживаемая файловая система %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s не является файлом"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "неизвестный тип загрузки %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "схема раздела должна быть mbr или gpt"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "целевая система должна быть bios, uefi или dual"

#: fubuki/job.py:126
msgid "no image given"
msgstr "не указан образ"

#: fubuki/job.py:128
msgid "no device given"
msgstr "не указано устройство"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT требует целевую систему UEFI"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS требует основной раздел NTFS или exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s содержит работающую систему; запись отклонена"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s является внутренним диском; запись отклонена"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s является loop-устройством; запись отклонена"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Сканирование образа…"

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "этот ISO не является гибридным образом и не может быть записан в режиме DD"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go требует образ с sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go требует NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "этот образ содержит файлы размером более 4 ГБ, которые невозможно разделить; используйте NTFS или exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "этот образ не поддерживает постоянный раздел"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "этот образ содержит файлы размером более 4 ГБ; FAT32 их не поддерживает, используйте NTFS или exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "образу требуется %s, а на диске есть только %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Запись образа…"

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Завершение…"

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Обнуление диска…"

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Создание таблицы разделов…"

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Форматирование…"

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Запись загрузочных записей…"

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Копирование файлов…"

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Подготовка тома…"

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "не удалось прочитать GUID разделов из новой таблицы"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Применение настроек…"

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Завершение записи файлов…"

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Проверка на сбойные блоки…"

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "проверка обнаружила сбойных блоков: %d; этому диску нельзя доверять"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go требует %s временного места в %s; доступно только %s (укажите в TMPDIR каталог с большим объёмом свободного места)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Извлечение установочного образа…"

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "в образе отсутствует шаблон BCD для построения хранилища загрузки"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "неизвестная схема раздела %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "раздел MSR требует GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "запрошено сохранение данных без указания размера"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "слишком много разделов"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s не помещается на этом диске"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "диск слишком мал для этой разметки"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s не появился после разметки"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "ошибка extlinux: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s является активным разделом подкачки; сначала отключите его"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s используется (%s); закройте всё, что его использует, и повторите попытку"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "не удалось смонтировать %s (%s): %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "нет помощника монтирования"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "«%s» недоступно в этой системе%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "ошибка %s: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "неполная запись в %s по смещению %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "отсутствует файл данных: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s не является файлом WIM"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s не содержит XML-индекса"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "ошибка wimupdate: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "ошибка wimapply: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "куст реестра SYSTEM не содержит раздела Setup"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Применение настроек Windows…"

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "не найден sources/boot.wim; невозможно добавить файл ответов"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "Обновление boot.wim…"

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s не найден на носителе"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "на носителе есть \\minint, но нет параметра /minint и нет \\i386: непонятно, как его загружать"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s не найден в %s"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "в шаблоне BCD нет записи загрузчика ОС"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Применение образа Windows (это может занять некоторое время)…"

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "в применённом образе нет каталога Windows"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "в применённом образе нет каталога Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "не удалось смонтировать %s (NTFS): не сработали ни ntfs3, ни ntfs-3g"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "можно записывать только VHD-образы фиксированного размера; сначала преобразуйте динамический VHD/VHDX с помощью qemu-img"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "размер образа %s, а на диске есть только %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "образ больше, чем диск"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "проверка не удалась по смещению %s: содержимое диска не совпадает с записанным"
