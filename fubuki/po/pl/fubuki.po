#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "nieznany typ MBR %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "za mało miejsca przed pierwszą partycją na program rozruchowy (odznacz „Dodaj poprawki dla starych BIOS-ów”)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "nowy wolumin nie ma sektora rozruchowego NTFS"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "nowy wolumin nie ma sektora rozruchowego FAT32"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "nowy wolumin nie ma sektora rozruchowego FAT16"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "brak obsługi rekordu rozruchowego dla %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Zapis na dysk wymaga uprawnień roota: uruchom przez pkexec lub sudo"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s nie jest dyskiem"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "„%s” ma rozmiar %s: FAT32 nie obsługuje plików większych niż 4 GB. Użyj NTFS lub exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "nie można zapisać %s: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "podział %s wymaga %s miejsca tymczasowego w %s, dostępne jest tylko %s. Użyj NTFS zamiast FAT32 lub ustaw TMPDIR na lokalizację z większą ilością miejsca."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Dzielenie install.wim dla FAT32…"

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "nieobsługiwany system plików %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s nie jest plikiem"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "nieznany typ rozruchu %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "schemat musi być mbr lub gpt"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "system docelowy musi być bios, uefi lub dual"

#: fubuki/job.py:126
msgid "no image given"
msgstr "nie podano obrazu"

#: fubuki/job.py:128
msgid "no device given"
msgstr "nie podano urządzenia"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT wymaga systemu docelowego UEFI"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS wymaga głównej partycji NTFS lub exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s zawiera uruchomiony system; odmowa zapisu"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s jest dyskiem wewnętrznym; odmowa zapisu"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s jest urządzeniem loop; odmowa zapisu"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Skanowanie obrazu…"

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "ten obraz ISO nie jest obrazem hybrydowym i nie można go zapisać w trybie DD"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go wymaga obrazu zawierającego sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go wymaga NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "ten obraz zawiera pliki większe niż 4 GB, których nie można podzielić; użyj NTFS lub exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "ten obraz nie obsługuje partycji trwałej"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "ten obraz zawiera pliki większe niż 4 GB; FAT32 ich nie obsługuje, użyj NTFS lub exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "obraz wymaga %s, a dysk ma tylko %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Zapisywanie obrazu…"

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Kończenie…"

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Zerowanie dysku…"

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Tworzenie tablicy partycji…"

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Formatowanie…"

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Zapisywanie rekordów rozruchowych…"

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Kopiowanie plików…"

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Przygotowywanie woluminu…"

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "nie można odczytać GUID-ów partycji z nowej tablicy"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Stosowanie personalizacji…"

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Kończenie zapisu plików…"

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Sprawdzanie wadliwych bloków…"

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "sprawdzanie wadliwych bloków wykryło %d wadliwych bloków; temu dyskowi nie należy ufać"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go wymaga %s miejsca tymczasowego w %s; dostępne jest tylko %s (ustaw TMPDIR na lokalizację z większą ilością miejsca)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Wyodrębnianie obrazu instalacyjnego…"

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "obraz nie zawiera szablonu BCD do zbudowania magazynu rozruchowego"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "nieznany schemat partycji %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "partycja MSR wymaga GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "zażądano trwałości bez podania rozmiaru"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "za dużo partycji"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s nie mieści się na tym dysku"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "dysk jest za mały dla tego układu partycji"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s nie pojawił się po partycjonowaniu"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux nie powiodło się: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s jest aktywną partycją wymiany; najpierw ją dezaktywuj"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s jest w użyciu (%s); zamknij wszystko, co go używa, i spróbuj ponownie"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "nie można zamontować %s (%s): %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "brak pomocnika montowania"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "„%s” nie jest dostępne w tym systemie%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s nie powiodło się: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "niepełny zapis do %s w %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "brak pliku danych: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s nie jest plikiem WIM"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s nie ma indeksu XML"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate nie powiodło się: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply nie powiodło się: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "gałąź rejestru SYSTEM nie ma klucza Setup"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Stosowanie personalizacji Windows…"

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "nie znaleziono sources/boot.wim; nie można dodać pliku odpowiedzi"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "Aktualizowanie boot.wim…"

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "nie znaleziono %s\\%s na nośniku"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "nośnik zawiera \\minint, ale brak opcji /minint i brak \\i386: nie wiadomo, jak go uruchomić"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "nie znaleziono %s w %s"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "brak wpisu programu ładującego system w szablonie BCD"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Stosowanie obrazu Windows (to może chwilę potrwać)…"

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "zastosowany obraz nie ma katalogu Windows"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "zastosowany obraz nie ma katalogu Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "nie można zamontować %s (NTFS): nie zadziałał ani ntfs3, ani ntfs-3g"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "można zapisywać tylko obrazy VHD o stałym rozmiarze; najpierw przekonwertuj dynamiczny VHD/VHDX za pomocą qemu-img"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "obraz ma rozmiar %s, a dysk ma tylko %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "obraz jest większy niż dysk"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "weryfikacja nie powiodła się przy przesunięciu %s: dysk nie zawiera zapisanych danych"
