#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "unbekannter MBR-Typ %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "nicht genug Platz vor der ersten Partition für den Bootloader (deaktivieren Sie „Korrekturen für alte BIOS-Versionen hinzufügen“)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "neues Volume hat keinen NTFS-Bootsektor"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "neues Volume hat keinen FAT32-Bootsektor"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "neues Volume hat keinen FAT16-Bootsektor"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "keine Unterstützung für Bootsektoren für %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Das Schreiben eines Laufwerks benötigt Root-Rechte: über pkexec oder sudo ausführen"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s ist kein Datenträger"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "„%s“ ist %s: FAT32 kann keine Dateien über 4 GB speichern. Verwenden Sie NTFS oder exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "%s konnte nicht geschrieben werden: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "das Aufteilen von %s benötigt %s temporären Speicherplatz in %s, nur %s frei. Verwenden Sie NTFS statt FAT32, oder setzen Sie TMPDIR auf einen Ort mit mehr Platz."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "install.wim wird für FAT32 aufgeteilt …"

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "nicht unterstütztes Dateisystem %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s ist keine Datei"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "unbekannter Boot-Typ %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "Schema muss mbr oder gpt sein"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "Ziel muss bios, uefi oder dual sein"

#: fubuki/job.py:126
msgid "no image given"
msgstr "kein Abbild angegeben"

#: fubuki/job.py:128
msgid "no device given"
msgstr "kein Gerät angegeben"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT benötigt ein UEFI-Ziel"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS benötigt eine Hauptpartition mit NTFS oder exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s enthält das laufende System; Schreibvorgang wird verweigert"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s ist ein internes Laufwerk; Schreibvorgang wird verweigert"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s ist ein Loop-Gerät; Schreibvorgang wird verweigert"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Abbild wird gescannt …"

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "diese ISO-Datei ist kein Hybrid-Abbild und kann nicht im DD-Modus geschrieben werden"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go benötigt ein Abbild mit sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go benötigt NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "dieses Abbild enthält Dateien über 4 GB, die nicht aufgeteilt werden können; verwenden Sie NTFS oder exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "dieses Abbild unterstützt keine persistente Partition"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "dieses Abbild enthält Dateien über 4 GB; FAT32 kann diese nicht speichern, verwenden Sie NTFS oder exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "das Abbild benötigt %s, das Laufwerk hat aber nur %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Abbild wird geschrieben …"

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Wird abgeschlossen …"

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Laufwerk wird genullt …"

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Partitionstabelle wird erstellt …"

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Wird formatiert …"

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Bootsätze werden geschrieben …"

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Dateien werden kopiert …"

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Volume wird vorbereitet …"

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "die Partitions-GUIDs konnten nicht aus der neuen Tabelle zurückgelesen werden"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Anpassung wird angewendet …"

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Dateien werden abgeschlossen …"

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Es wird auf fehlerhafte Blöcke geprüft …"

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "die Prüfung auf fehlerhafte Blöcke hat %d fehlerhafte(n) Block(e) gefunden; diesem Laufwerk sollte nicht vertraut werden"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go benötigt %s temporären Speicherplatz in %s; nur %s frei (setzen Sie TMPDIR auf einen Ort mit mehr Platz)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Installationsabbild wird extrahiert …"

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "das Abbild enthält keine BCD-Vorlage, aus der der Boot-Speicher erstellt werden kann"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "unbekanntes Partitionsschema %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "eine MSR-Partition benötigt GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "Persistenz angefordert, aber keine Größe angegeben"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "zu viele Partitionen"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s passt nicht auf dieses Laufwerk"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "Laufwerk ist für dieses Layout zu klein"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s erschien nach dem Partitionieren nicht"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux fehlgeschlagen: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s ist aktiver Swap-Speicher; zuerst deaktivieren"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s wird verwendet (%s); schließen Sie alles, was darauf zugreift, und versuchen Sie es erneut"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "%s (%s) konnte nicht eingehängt werden: %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "kein Einhänge-Hilfsprogramm"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "„%s“ ist auf diesem System nicht verfügbar%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s fehlgeschlagen: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "unvollständiger Schreibvorgang bei %s an Position %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "fehlende Nutzdatendatei: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s ist keine WIM-Datei"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s hat keinen XML-Index"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate fehlgeschlagen: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply fehlgeschlagen: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "SYSTEM-Hive hat keinen Setup-Schlüssel"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Windows-Anpassung wird angewendet …"

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim nicht gefunden; Antwortdatei kann nicht hinzugefügt werden"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "boot.wim wird aktualisiert …"

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s wurde auf dem Medium nicht gefunden"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "Medium enthält \\minint, aber keine Option /minint und kein \\i386: unklar, wie es gestartet werden soll"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s wurde in %s nicht gefunden"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "kein Betriebssystem-Ladeeintrag in der BCD-Vorlage"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Windows-Abbild wird angewendet (dies kann eine Weile dauern) …"

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "das angewendete Abbild hat kein Windows-Verzeichnis"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "das angewendete Abbild hat kein Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "%s (NTFS) konnte nicht eingehängt werden: weder ntfs3 noch ntfs-3g funktionierten"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "es können nur VHD-Abbilder mit fester Größe geschrieben werden; konvertieren Sie dynamische VHD/VHDX zuerst mit qemu-img"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "Abbild ist %s groß, aber das Laufwerk fasst nur %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "Abbild ist größer als das Laufwerk"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "Überprüfung bei Offset %s fehlgeschlagen: Das Laufwerk enthält nicht das, was geschrieben wurde"
