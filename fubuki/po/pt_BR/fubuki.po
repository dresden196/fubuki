#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "tipo de MBR desconhecido: %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "espaço insuficiente antes da primeira partição para o carregador de inicialização (desmarque 'Adicionar correções para BIOS antigas')"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "o novo volume não tem um setor de inicialização NTFS"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "o novo volume não tem um setor de inicialização FAT32"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "o novo volume não tem um setor de inicialização FAT16"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "sem suporte a registro de inicialização para %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Gravar uma unidade precisa de root: execute via pkexec ou sudo"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s não é um disco"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "'%s' é %s: o FAT32 não pode conter arquivos maiores que 4 GB. Use NTFS ou exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "não foi possível gravar %s: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "dividir %s requer %s de espaço temporário em %s, apenas %s livre. Use NTFS em vez de FAT32, ou defina TMPDIR para um local com mais espaço."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Dividindo install.wim para FAT32..."

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "sistema de arquivos não suportado: %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s não é um arquivo"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "tipo de inicialização desconhecido: %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "o esquema deve ser mbr ou gpt"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "o destino deve ser bios, uefi ou dual"

#: fubuki/job.py:126
msgid "no image given"
msgstr "nenhuma imagem informada"

#: fubuki/job.py:128
msgid "no device given"
msgstr "nenhum dispositivo informado"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT requer um destino UEFI"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS requer uma partição principal NTFS ou exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s contém o sistema em execução; gravação recusada"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s é uma unidade interna; gravação recusada"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s é um dispositivo loop; gravação recusada"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Analisando a imagem..."

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "esta ISO não é uma imagem híbrida e não pode ser gravada no modo DD"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "o Windows To Go requer uma imagem com sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "o Windows To Go requer NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "esta imagem tem arquivos maiores que 4 GB que não podem ser divididos; use NTFS ou exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "esta imagem não suporta uma partição persistente"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "esta imagem tem arquivos maiores que 4 GB; o FAT32 não pode contê-los, use NTFS ou exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "a imagem requer %s, mas a unidade tem %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Gravando a imagem..."

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Finalizando..."

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Zerando a unidade..."

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Criando a tabela de partições..."

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Formatando..."

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Gravando os registros de inicialização..."

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Copiando arquivos..."

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Preparando o volume..."

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "não foi possível reler os GUIDs das partições na nova tabela"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Aplicando a personalização..."

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Finalizando arquivos..."

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Verificando blocos defeituosos..."

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "a verificação de blocos defeituosos encontrou %d bloco(s) defeituoso(s); esta unidade não deve ser considerada confiável"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "o Windows To Go requer %s de espaço temporário em %s; apenas %s livre (defina TMPDIR para um local com mais espaço)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Extraindo a imagem de instalação..."

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "a imagem não tem um modelo de BCD a partir do qual criar o repositório de inicialização"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "esquema de partição desconhecido: %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "uma partição MSR requer GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "persistência solicitada sem um tamanho"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "excesso de partições"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s não cabe nesta unidade"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "a unidade é pequena demais para este layout"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s não apareceu após o particionamento"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux falhou: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s é swap ativo; desative-o primeiro"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s está em uso (%s); feche tudo o que estiver usando e tente novamente"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "não foi possível montar %s (%s): %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "nenhum auxiliar de montagem"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "'%s' não está disponível neste sistema%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s falhou: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "gravação incompleta em %s em %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "arquivo de payload ausente: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s não é um arquivo WIM"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s não tem um índice XML"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate falhou: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply falhou: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "a colmeia SYSTEM não tem a chave Setup"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Aplicando a personalização do Windows..."

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim não encontrado; não é possível adicionar o arquivo de resposta"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "Atualizando boot.wim..."

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s não encontrado na mídia"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "a mídia tem \\minint, mas nenhuma opção /minint e nenhum \\i386: não está claro como inicializá-la"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s não encontrado em %s"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "nenhuma entrada de carregador de sistema operacional no modelo de BCD"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Aplicando a imagem do Windows (isso pode demorar um pouco)..."

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "a imagem aplicada não tem uma pasta Windows"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "a imagem aplicada não tem Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "não foi possível montar %s (NTFS): nem ntfs3 nem ntfs-3g funcionaram"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "somente imagens VHD de tamanho fixo podem ser gravadas; converta VHD/VHDX dinâmicos com o qemu-img primeiro"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "a imagem tem %s, mas a unidade comporta apenas %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "a imagem é maior que a unidade"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "a verificação falhou no deslocamento %s: a unidade não contém o que foi gravado"
