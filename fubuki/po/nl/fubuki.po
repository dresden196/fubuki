#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "onbekend MBR-type %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "onvoldoende ruimte vóór de eerste partitie voor de bootloader (schakel 'Correcties voor oude BIOS'en toevoegen' uit)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "nieuw volume heeft geen NTFS-opstartsector"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "nieuw volume heeft geen FAT32-opstartsector"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "nieuw volume heeft geen FAT16-opstartsector"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "geen ondersteuning voor opstartrecord voor %s"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Het schrijven van een schijf vereist root: voer uit via pkexec of sudo"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s is geen schijf"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "'%s' is %s: FAT32 kan geen bestanden groter dan 4 GB bevatten. Gebruik NTFS of exFAT."

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "kon %s niet schrijven: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "het splitsen van %s vereist %s tijdelijke ruimte in %s, slechts %s vrij. Gebruik NTFS in plaats van FAT32, of stel TMPDIR in op een locatie met meer ruimte."

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "install.wim wordt gesplitst voor FAT32..."

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "niet-ondersteund bestandssysteem %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s is geen bestand"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "onbekend opstarttype %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "schema moet mbr of gpt zijn"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "doel moet bios, uefi of dual zijn"

#: fubuki/job.py:126
msgid "no image given"
msgstr "geen image opgegeven"

#: fubuki/job.py:128
msgid "no device given"
msgstr "geen apparaat opgegeven"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT vereist een UEFI-doel"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS vereist een hoofdpartitie met NTFS of exFAT"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s bevat het actieve systeem; schrijven geweigerd"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s is een intern station; schrijven geweigerd"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s is een loop-apparaat; schrijven geweigerd"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "Image wordt gescand..."

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "deze ISO is geen hybride image en kan niet in DD-modus worden geschreven"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go vereist een image met sources/install.wim"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go vereist NTFS"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "deze image bevat bestanden groter dan 4 GB die niet kunnen worden gesplitst; gebruik NTFS of exFAT"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "deze image ondersteunt geen permanente partitie"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "deze image bevat bestanden groter dan 4 GB; FAT32 kan deze niet bevatten, gebruik NTFS of exFAT"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "de image vereist %s maar het station heeft %s"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "Image wordt geschreven..."

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "Bezig met afronden..."

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "Station wordt genuld..."

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "Partitietabel wordt aangemaakt..."

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "Bezig met formatteren..."

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "Opstartrecords worden geschreven..."

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "Bestanden worden gekopieerd..."

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "Volume wordt voorbereid..."

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "kon de partitie-GUID's niet terug uit de nieuwe tabel lezen"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "Aanpassingen worden toegepast..."

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "Bestanden worden afgerond..."

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "Controleren op slechte blokken..."

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "de controle op slechte blokken vond %d slecht(e) blok(ken); dit station is niet betrouwbaar"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go vereist %s tijdelijke ruimte in %s; slechts %s vrij (stel TMPDIR in op een locatie met meer ruimte)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "Installatie-image wordt uitgepakt..."

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "image heeft geen BCD-sjabloon om de opstartopslag mee op te bouwen"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "onbekend partitieschema %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "een MSR-partitie vereist GPT"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "persistentie aangevraagd zonder grootte"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "te veel partities"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s past niet op dit station"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "station is te klein voor deze indeling"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s verscheen niet na het partitioneren"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux is mislukt: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s is actieve swap; deactiveer deze eerst"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s is in gebruik (%s); sluit alles wat het gebruikt en probeer het opnieuw"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "kon %s niet koppelen (%s): %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "geen koppelhelper"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "'%s' is niet beschikbaar op dit systeem%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s is mislukt: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "onvolledige schrijfactie naar %s bij %s"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "ontbrekend payloadbestand: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s is geen WIM-bestand"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s heeft geen XML-index"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate is mislukt: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply is mislukt: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "SYSTEM-hive heeft geen Setup-sleutel"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Windows-aanpassingen worden toegepast..."

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim niet gevonden; kan het antwoordbestand niet toevoegen"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "boot.wim wordt bijgewerkt..."

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s niet gevonden op de media"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "media heeft \\minint maar geen /minint-optie en geen \\i386: onduidelijk hoe op te starten"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s niet gevonden in %s"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "geen besturingssysteemlader-item in de BCD-sjabloon"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Windows-image wordt toegepast (dit duurt even)..."

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "toegepaste image heeft geen Windows-map"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "toegepaste image heeft geen Windows\\Boot\\EFI"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "kon %s niet koppelen (NTFS): noch ntfs3 noch ntfs-3g werkte"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "alleen VHD-images met vaste grootte kunnen worden geschreven; converteer dynamische VHD/VHDX eerst met qemu-img"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "image is %s maar het station biedt slechts %s"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "image is groter dan het station"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "verificatie is mislukt bij offset %s: het station bevat niet wat er is geschreven"
