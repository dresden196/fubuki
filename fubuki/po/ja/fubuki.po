#: fubuki/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "不明なMBRタイプ %s"

#: fubuki/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "ブートローダー用の空き容量が最初のパーティションの前に不足しています(「古いBIOS向けの修正を追加」のチェックを外してください)"

#: fubuki/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "新しいボリュームにNTFSのブートセクタがありません"

#: fubuki/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "新しいボリュームにFAT32のブートセクタがありません"

#: fubuki/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "新しいボリュームにFAT16のブートセクタがありません"

#: fubuki/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "%s のブートレコードはサポートされていません"

#: fubuki/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "ドライブへの書き込みにはroot権限が必要です: pkexecまたはsudo経由で実行してください"

#: fubuki/cli.py:116 fubuki/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s はディスクではありません"

#: fubuki/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "「%s」は%sです。FAT32は4 GBを超えるファイルを保存できません。NTFSまたはexFATを使用してください。"

#: fubuki/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "%s を書き込めませんでした: %s"

#: fubuki/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "%s の分割には %s の一時領域が %s に必要ですが、空き容量は %s しかありません。FAT32の代わりにNTFSを使用するか、TMPDIRをより空き容量の大きい場所に設定してください。"

#: fubuki/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "FAT32用にinstall.wimを分割しています…"

#: fubuki/fs.py:110 fubuki/job.py:124 fubuki/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "サポートされていないファイルシステムです: %s"

#: fubuki/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s はファイルではありません"

#: fubuki/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "不明なブートタイプです: %s"

#: fubuki/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "パーティション方式はmbrまたはgptである必要があります"

#: fubuki/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "ターゲットシステムはbios、uefi、またはdualである必要があります"

#: fubuki/job.py:126
msgid "no image given"
msgstr "イメージが指定されていません"

#: fubuki/job.py:128
msgid "no device given"
msgstr "デバイスが指定されていません"

#: fubuki/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPTを使用するにはUEFIターゲットが必要です"

#: fubuki/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFSにはNTFSまたはexFATのメインパーティションが必要です"

#: fubuki/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s には実行中のシステムが含まれているため、書き込みを拒否します"

#: fubuki/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s は内蔵ドライブのため、書き込みを拒否します"

#: fubuki/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s はループデバイスのため、書き込みを拒否します"

#: fubuki/job.py:158
msgid "Scanning image..."
msgstr "イメージをスキャンしています…"

#: fubuki/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "このISOはハイブリッドイメージではないため、DDモードで書き込めません"

#: fubuki/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Goにはsources/install.wimを含むイメージが必要です"

#: fubuki/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To GoにはNTFSが必要です"

#: fubuki/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "このイメージには分割できない4 GBを超えるファイルが含まれています。NTFSまたはexFATを使用してください"

#: fubuki/job.py:172
msgid "this image does not support a persistent partition"
msgstr "このイメージは永続パーティションに対応していません"

#: fubuki/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "このイメージには4 GBを超えるファイルが含まれています。FAT32では保存できないため、NTFSまたはexFATを使用してください"

#: fubuki/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "このイメージには %s が必要ですが、ドライブの容量は %s しかありません"

#: fubuki/job.py:228
msgid "Writing image..."
msgstr "イメージを書き込んでいます…"

#: fubuki/job.py:230 fubuki/job.py:393
msgid "Finalizing..."
msgstr "仕上げ処理をしています…"

#: fubuki/job.py:234
msgid "Zeroing drive..."
msgstr "ドライブをゼロクリアしています…"

#: fubuki/job.py:239
msgid "Creating partition table..."
msgstr "パーティションテーブルを作成しています…"

#: fubuki/job.py:264
msgid "Formatting..."
msgstr "フォーマットしています…"

#: fubuki/job.py:285
msgid "Writing boot records..."
msgstr "ブートレコードを書き込んでいます…"

#: fubuki/job.py:321
msgid "Copying files..."
msgstr "ファイルをコピーしています…"

#: fubuki/job.py:321
msgid "Preparing volume..."
msgstr "ボリュームを準備しています…"

#: fubuki/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "新しいテーブルからパーティションGUIDを読み取れませんでした"

#: fubuki/job.py:383
msgid "Applying customization..."
msgstr "カスタマイズを適用しています…"

#: fubuki/job.py:383
msgid "Finalizing files..."
msgstr "ファイルを仕上げています…"

#: fubuki/job.py:434
msgid "Checking for bad blocks..."
msgstr "不良ブロックを確認しています…"

#: fubuki/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "不良ブロック検査で %d 個の不良ブロックが見つかりました。このドライブは信頼できません"

#: fubuki/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Goには %s の一時領域が %s に必要ですが、空き容量は %s しかありません(TMPDIRをより空き容量の大きい場所に設定してください)"

#: fubuki/job.py:481
msgid "Extracting install image..."
msgstr "インストールイメージを展開しています…"

#: fubuki/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "イメージにブートストア作成用のBCDテンプレートがありません"

#: fubuki/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "不明なパーティション方式です: %s"

#: fubuki/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "MSRパーティションにはGPTが必要です"

#: fubuki/layout.py:110
msgid "persistence requested with no size"
msgstr "永続化が要求されましたがサイズが指定されていません"

#: fubuki/layout.py:138
msgid "too many partitions"
msgstr "パーティションが多すぎます"

#: fubuki/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s はこのドライブに収まりません"

#: fubuki/layout.py:150 fubuki/layout.py:155
msgid "drive is too small for this layout"
msgstr "このレイアウトにはドライブの容量が小さすぎます"

#: fubuki/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "パーティション作成後に %s が見つかりませんでした"

#: fubuki/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinuxが失敗しました: %s"

#: fubuki/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s は使用中のスワップ領域です。先に無効化してください"

#: fubuki/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s は使用中です(%s)。使用しているものを閉じてから再試行してください"

#: fubuki/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "%s (%s) をマウントできませんでした: %s"

#: fubuki/mountctl.py:128
msgid "no mount helper"
msgstr "マウントヘルパーがありません"

#: fubuki/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "「%s」はこのシステムでは利用できません%s"

#: fubuki/util.py:180 fubuki/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s が失敗しました: %s"

#: fubuki/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "%s の %s への書き込みが不完全でした"

#: fubuki/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "ペイロードファイルが見つかりません: %s"

#: fubuki/wim.py:59 fubuki/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s はWIMファイルではありません"

#: fubuki/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s にXMLインデックスがありません"

#: fubuki/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdateが失敗しました: %s"

#: fubuki/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapplyが失敗しました: %s"

#: fubuki/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "SYSTEMハイブにSetupキーがありません"

#: fubuki/windows.py:97
msgid "Applying Windows customization..."
msgstr "Windowsのカスタマイズを適用しています…"

#: fubuki/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wimが見つかりません。応答ファイルを追加できません"

#: fubuki/windows.py:187
msgid "Updating boot.wim..."
msgstr "boot.wimを更新しています…"

#: fubuki/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "メディア上に %s\\%s が見つかりません"

#: fubuki/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "メディアに\\minintはありますが/minintオプションと\\i386がないため、起動方法を判別できません"

#: fubuki/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s が %s に見つかりません"

#: fubuki/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "BCDテンプレートにOSローダーのエントリがありません"

#: fubuki/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Windowsイメージを適用しています(しばらく時間がかかります)…"

#: fubuki/windows.py:488
msgid "applied image has no Windows directory"
msgstr "適用したイメージにWindowsディレクトリがありません"

#: fubuki/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "適用したイメージにWindows\\Boot\\EFIがありません"

#: fubuki/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "%s (NTFS) をマウントできませんでした: ntfs3、ntfs-3gのどちらも失敗しました"

#: fubuki/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "固定サイズのVHDイメージのみ書き込めます。動的サイズのVHD/VHDXは先にqemu-imgで変換してください"

#: fubuki/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "イメージは %s ですが、ドライブの容量は %s しかありません"

#: fubuki/writer.py:111
msgid "image is larger than the drive"
msgstr "イメージがドライブより大きいです"

#: fubuki/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "オフセット %s で検証に失敗しました: ドライブの内容が書き込んだデータと一致しません"