# Maintainer: SakuraOS <dev@sakuraos.invalid>
#
# The USB writer's window. Everything that looks at a disk or an image and
# every decision about what will boot lives in sakura-usb; this draws what
# the engine reports and hands it a job. A second opinion here would be the
# one people believed, and the one nobody tested.
pkgname=sakura-usb-ui
pkgver=0.1.0
pkgrel=1
pkgdesc="Sakura USB Writer"
arch=('x86_64')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
depends=('sakura-usb' 'qt6-base' 'qt6-declarative' 'kirigami' 'ki18n'
         'qqc2-desktop-style' 'polkit' 'systemd')
makedepends=('cmake' 'extra-cmake-modules' 'qt6-tools')

build() {
    cp -r "$startdir/app" "$srcdir/app-src"
    cmake -S "$srcdir/app-src" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$startdir/org.sakuraos.usb.desktop" \
        "$pkgdir/usr/share/applications/org.sakuraos.usb.desktop"
}
