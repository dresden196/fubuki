# Maintainer: Dresden Wildey <dresden196@gmail.com>
#
# The USB writer's GNOME window. Like fubuki-ui (the KDE one) it draws what
# the fubuki engine reports and hands it a job; the two front-ends share
# the engine package and may be installed side by side.
pkgname=fubuki-gtk
pkgver=0.2.1
pkgrel=1
pkgdesc="Fubuki bootable USB writer: the GNOME window"
arch=('any')
url="https://github.com/dresden196/fubuki"
license=('GPL-3.0-or-later')
depends=('fubuki' 'python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit')
makedepends=('gettext')

package() {
    install -Dm755 "$startdir/bin/fubuki-gtk" "$pkgdir/usr/bin/fubuki-gtk"
    install -d "$pkgdir/usr/lib/fubuki-gtk/fubuki_gtk"
    install -Dm644 "$startdir"/fubuki_gtk/*.py -t "$pkgdir/usr/lib/fubuki-gtk/fubuki_gtk/"
    install -Dm644 "$startdir/io.github.dresden196.fubuki.gtk.desktop" \
        "$pkgdir/usr/share/applications/io.github.dresden196.fubuki.gtk.desktop"
    install -Dm644 "$startdir/io.github.dresden196.fubuki.gtk.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.dresden196.fubuki.gtk.metainfo.xml"
    # The icon (hicolor/scalable/apps/fubuki.svg) comes with the engine
    # package, which both front-ends depend on.

    # Window strings, when a catalog exists (po/<lang>/fubuki-gtk.po).
    for po in "$startdir"/po/*/fubuki-gtk.po; do
        [ -f "$po" ] || continue
        lang=$(basename "$(dirname "$po")")
        install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/fubuki-gtk.mo" "$po"
    done
}
